# Backend Environment Configuration Template
ENV=development
DATABASE_URL=sqlite:///./fraud_detection.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your_dev_jwt_secret_change_in_production
ENCRYPTION_SECRET_KEY=your_dev_encryption_key_change_in_production
LLM_PROVIDER=null
LLM_MODEL=null-deterministic-v1
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_HOST=http://localhost:11434
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3
RATE_LIMIT_ENABLED=true
STRICT_ENTERPRISE_MODE=true
