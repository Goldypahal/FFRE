# ==============================================================================
# FFRE / FFIRE PRODUCTION CONFIGURATION TEMPLATE
# DO NOT COMMIT SECRETS OR USE DEVELOPMENT/DISPOSABLE PASSWORDS IN PRODUCTION!
# ==============================================================================

# Database Persistence (PostgreSQL 15+ / TimescaleDB)
# Use a least-privilege unprivileged application user with SSL enabled (sslmode=require)
DATABASE_URL=postgresql://ffire_app_user:REPLACE_WITH_STRONG_DB_PASSWORD@postgres-primary.internal:5432/ffire_production?sslmode=require
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Distributed State & Queue Broker (Redis 7+ Cluster)
# Requires TLS and AUTH in production environments
REDIS_URL=rediss://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis-cluster.internal:6379/0

# Cryptographic Keys (MUST BE GENERATED VIA SECURE TRNG, e.g., openssl rand -hex 32)
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET_FOR_JWT_SIGNING
ENCRYPTION_SECRET_KEY=REPLACE_WITH_BASE64_AES256_FERNET_KEY

# Zero-Trust Administrator Bootstrap Secret (Mandatory for /api/v1/auth/bootstrap)
BOOTSTRAP_SECRET_KEY=REPLACE_WITH_SECURE_ADMIN_BOOTSTRAP_SECRET

# Asymmetric Ed25519 Verifier & Sealed Replay Keyring (Required in STRICT_ENTERPRISE_MODE)
# Generate with: openssl genpkey -algorithm ed25519 -outform PEM
VERIFIER_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ED25519_PKCS8_PRIVATE_KEY_PEM\n-----END PRIVATE KEY-----"
VERIFIER_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_ED25519_SPKI_PUBLIC_KEY_PEM\n-----END PUBLIC KEY-----"
TRUSTED_VERIFIER_PUBLIC_KEYS=REPLACE_WITH_COMMA_SEPARATED_HEX_OR_PEM_PUBLIC_KEYS

# Replay Bundle Signing Key (HMAC fallback key if not using asymmetric Ed25519)
REPLAY_SIGNING_KEY=REPLACE_WITH_64_CHAR_HEX_REPLAY_SIGNING_KEY

# Security & Compliance Modes
ENV=production
STRICT_ENTERPRISE_MODE=true
RATE_LIMIT_ENABLED=true
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3

# External LLM Engine (Optional - deterministic fallback operates if unset)
OPENAI_API_KEY=sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY

# Observability (OpenTelemetry / Prometheus)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.internal:4317


# Twilio SMS Multi-Factor Authentication & High-Risk Alerting
TWILIO_ACCOUNT_SID=REPLACE_WITH_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_AUTH_TOKEN
TWILIO_FROM_PHONE_NUMBER=REPLACE_WITH_TWILIO_PHONE_NUMBER
TWILIO_ALERT_RECIPIENT_PHONE=REPLACE_WITH_COMPLIANCE_ALERT_PHONE
