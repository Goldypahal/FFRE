# FFIRE (Financial Fraud Investigation Reasoning Engine) - Environment Configuration
# Copy this file to .env and customize values for your deployment.
# NEVER commit .env files containing real production secrets to version control.

# Application Environment (development | staging | production)
ENV=development

# Database Settings
# For local SQLite: sqlite:///./fraud_detection.db
# For PostgreSQL: postgresql://ffire_user:your_secure_password_here@localhost:5432/ffire_db
DATABASE_URL=postgresql://ffire_user:your_secure_password_here@localhost:5432/ffire_db
CHECKPOINT_DB_URL=postgresql://ffire_user:your_secure_password_here@localhost:5432/ffire_checkpoints

# Redis Queue & State Broker
REDIS_URL=redis://localhost:6379/0

# Authentication & JWT
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_signing_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Digital Evidence Vault & Master AES-256 Encryption
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_SECRET_KEY=your_base64_master_encryption_key_change_in_production
ENCRYPTION_SALT=your_pbkdf2_derivation_salt_change_in_production

# Reasoning Graph & Model Gateway
# Pluggable Model Gateway: openai | anthropic | ollama | null | mock
# When set to 'null' or 'mock', investigations run deterministically offline with zero network calls and zero cost.
LLM_PROVIDER=null
LLM_MODEL=null-deterministic-v1
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_HOST=http://localhost:11434
CONFIDENCE_THRESHOLD=0.85
MAX_RETRIES=3

# Operational Controls
RATE_LIMIT_ENABLED=true
STRICT_ENTERPRISE_MODE=true
PORT=8000
